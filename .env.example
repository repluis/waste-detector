# Copia este archivo como .env.local para sobreescribir valores en tu máquina.

# Ruta (o URL) del modelo ONNX. Por defecto: /models/waste-detector.onnx
VITE_MODEL_URL=/models/waste-detector.onnx

# Confianza mínima (0-1) para mostrar una detección
VITE_SCORE_THRESHOLD=0.4

# Nivel de logs en consola: debug | info | warn | error | silent
# Por defecto: debug en desarrollo, info en producción.
# En producción también puedes cambiarlo desde la consola: wasteVision.setLogLevel('debug')
VITE_LOG_LEVEL=debug
